# Valeurs publiques uniquement. Copier vers .env.local (ignoré par Git).
# La phase 2 démarre sans ces valeurs ; la connexion sera ajoutée en phase 3.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternative pour les projets avec une ancienne clé publique :
# VITE_SUPABASE_ANON_KEY=
# Ne jamais placer de clé service_role ou sb_secret_ dans une variable VITE_*.
